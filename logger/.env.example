# Copy this file to .env beside docker-compose.yml. Docker Compose reads it;
# variables already exported in your shell take precedence. Python does not
# load this file automatically. Replace every YOUR_/REPLACE_ value and host path
# with your own resources before starting services. Keep your .env untracked.

# Bind the application to this computer by default.
HOST_BIND=127.0.0.1
APP_PORT=7001
FLASK_DEBUG=0
# Required: generate your own random secret; the placeholder is not a safe key.
FLASK_SECRET_KEY=REPLACE_WITH_YOUR_RANDOM_SECRET_KEY

# These must be existing JSON files on the host, preferably outside the repo.
# For Vertex-only use, API_KEYS_FILE can point to your own file containing {}.
# A vertex_ai section in that file can override Vertex settings below.
# Use your own Google Cloud service-account credentials; never commit the JSON.
API_KEYS_FILE=/path/to/your/api_keys.json
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service_account.json
# Container path of the read-only credential mount, not the host file path.
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account.json

# Vertex requires your own Google Cloud resources and compatible authentication.
# Placeholders do not provide working access or validate a cloud connection.
SEARCH_BACKEND=vertex
VERTEX_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
VERTEX_LOCATION=global
VERTEX_ENGINE_ID=YOUR_ENGINE_ID
# Required for Vertex autocomplete.
VERTEX_DATA_STORE_ID=YOUR_DATA_STORE_ID
VERTEX_LANGUAGE_CODE=it
VERTEX_AUTOCOMPLETE_QUERY_MODEL=search-history

# Public autocomplete defaults used by the optional SerpAPI backend.
# That backend also requires your own serp_api key in API_KEYS_FILE.
SERP_AUTOCOMPLETE_HL=it
SERP_AUTOCOMPLETE_GL=it
SERP_AUTOCOMPLETE_CLIENT=gws-wiz
